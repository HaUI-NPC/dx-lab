  "clients": [
    {
      "clientId": "dxlab-portal",
      "name": "DX-Lab Portal",
      "description": "BFF đăng nhập của portal (authorization code + PKCE)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DXLAB_PORTAL_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": false,
      "rootUrl": "${DXLAB_PORTAL_PUBLIC_URL}",
      "baseUrl": "${DXLAB_PORTAL_PUBLIC_URL}",
      "redirectUris": [
        "${DXLAB_PORTAL_PUBLIC_URL}/auth/callback",
        "http://localhost:8001/auth/callback"
      ],
      "webOrigins": [
        "${DXLAB_PORTAL_PUBLIC_URL}",
        "http://localhost:8001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${DXLAB_PORTAL_PUBLIC_URL}/*##http://localhost:8001/*"
      },
      "protocolMappers": [
        {
          "name": "audience-dxlab-core",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "dxlab-core",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dxlab-cli",
      "name": "DX-Lab CLI",
      "description": "CLI và MCP: device authorization grant; direct access grant chỉ cho script demo",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "oauth2.device.code.lifespan": "600",
        "oauth2.device.polling.interval": "5"
      },
      "protocolMappers": [
        {
          "name": "audience-dxlab-core",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "dxlab-core",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "otp-required",
        "description": "Gán cho nhóm vai trò duyệt và quản trị (AUTHZ mục 10): thành viên bắt buộc xác thực hai bước"
      }
    ]
  },
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "authenticationFlows": [
    {
      "alias": "Account verification options",
      "description": "Method with which to verify the existing account",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": true,
      "authenticationExecutions": [
        {
          "authenticator": "idp-email-verification",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": true,
          "flowAlias": "Verify Existing Account by Re-authentication",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "Browser - Conditional 2FA",
      "description": "DX-Lab: bắt buộc OTP khi người dùng thuộc nhóm vai trò mang realm role otp-required (AUTHZ mục 10)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": true,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
