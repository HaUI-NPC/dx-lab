# Cấu hình DX-Lab cho Docker Compose. Sao chép thành `.env` ở gốc repo; `.env` không bao giờ được commit.
# `scripts/up.sh` tự tạo `.env` từ tệp này khi chưa có và sinh ngẫu nhiên mọi secret đang để trống.
# Biến nào tiến trình nào đọc, biến nào compose tự đặt: docs/ARCHITECTURE.md mục 5.

# --- URL công khai: địa chỉ trình duyệt, CLI và MCP dùng trên máy chạy compose ---
# Đổi cổng thì sửa đồng thời cổng tương ứng trong deploy/compose.yaml.
DXLAB_PORTAL_PUBLIC_URL=http://localhost:8000
DXLAB_KEYCLOAK_PUBLIC_URL=http://localhost:8180

# --- PostgreSQL ---
POSTGRES_DB=dxlab
POSTGRES_USER=dxlab
# Secret.
POSTGRES_PASSWORD=

# --- Keycloak ---
# Tài khoản vào trang quản trị http://localhost:8180/admin, không dùng cho nghiệp vụ.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
# Secret.
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Secret của client `dxlab-portal`; realm import đọc biến này, portal dùng cùng giá trị.
DXLAB_PORTAL_CLIENT_SECRET=
# Mật khẩu chung của các tài khoản demo trong docs/AUTHZ.md mục 11. Chỉ dùng cho demo.
DXLAB_DEMO_PASSWORD=

# --- Portal ---
# Secret ký cookie phiên.
DXLAB_PORTAL_SESSION_SECRET=

# --- Core ---
DXLAB_LOG_LEVEL=INFO
# Mô hình embedding cho tìm kiếm ngữ nghĩa (fastembed). Chưa tải mô hình thì /api/search chỉ dùng FTS.
DXLAB_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
