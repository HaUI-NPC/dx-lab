<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="overrun_defs" name="overrun" namespace="dxlab">
  <decision id="cost_overrun" name="Chi phí thực tế có vượt chi phí đã duyệt không (E2)">
    <description>docs/AUTHZ.md mục 5, luật E2. Chi phí đã duyệt là chi phí dự kiến tại lần duyệt gần nhất (estimated_cost_vnd); khi phải duyệt lại, bảng đặt estimated_cost_vnd bằng chi phí thực tế để authority tra lại.</description>
    <decisionTable id="cost_overrun_t" hitPolicy="FIRST">
      <input id="cost_overrun_t_in1" label="Chi phí thực tế (đồng)">
        <inputExpression id="cost_overrun_t_ie1" typeRef="number">
          <text>actual_cost_vnd</text>
        </inputExpression>
      </input>
      <output id="cost_overrun_t_out1" label="Phải duyệt lại" name="cost_recheck_required" typeRef="boolean" />
      <output id="cost_overrun_t_out2" label="Mã lý do" name="cost_recheck_reason" typeRef="string" />
      <output id="cost_overrun_t_out3" label="Chi phí đưa vào duyệt (đồng)" name="estimated_cost_vnd" typeRef="number" />
      <rule id="cost_overrun_t_r1">
        <description>Vượt chi phí đã duyệt quá 10%: duyệt lại theo chi phí thực tế</description>
        <inputEntry id="cost_overrun_t_r1_i1">
          <text>&gt; estimated_cost_vnd * 1.1</text>
        </inputEntry>
        <outputEntry id="cost_overrun_t_r1_o1">
          <text>True</text>
        </outputEntry>
        <outputEntry id="cost_overrun_t_r1_o2">
          <text>"VUOT_10_PHAN_TRAM"</text>
        </outputEntry>
        <outputEntry id="cost_overrun_t_r1_o3">
          <text>actual_cost_vnd</text>
        </outputEntry>
      </rule>
      <rule id="cost_overrun_t_r2">
        <description>Vượt hạn mức của người đã duyệt: duyệt lại theo chi phí thực tế</description>
        <inputEntry id="cost_overrun_t_r2_i1">
          <text>&gt; approval_limit_vnd</text>
        </inputEntry>
        <outputEntry id="cost_overrun_t_r2_o1">
          <text>True</text>
        </outputEntry>
        <outputEntry id="cost_overrun_t_r2_o2">
          <text>"VUOT_HAN_MUC_NGUOI_DUYET"</text>
        </outputEntry>
        <outputEntry id="cost_overrun_t_r2_o3">
          <text>actual_cost_vnd</text>
        </outputEntry>
      </rule>
      <rule id="cost_overrun_t_r3">
        <description>Trong ngưỡng: giữ nguyên chi phí đã duyệt</description>
        <inputEntry id="cost_overrun_t_r3_i1">
          <text>-</text>
        </inputEntry>
        <outputEntry id="cost_overrun_t_r3_o1">
          <text>False</text>
        </outputEntry>
        <outputEntry id="cost_overrun_t_r3_o2">
          <text>"TRONG_NGUONG"</text>
        </outputEntry>
        <outputEntry id="cost_overrun_t_r3_o3">
          <text>estimated_cost_vnd</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
